{{- $index := slice -}}
{{ $pages := .Site.Pages }}
{{ range .Site.Home.Translations }}
{{ $pages = $pages | lang.Merge .Site.Pages }}
{{ end }}
{{- range $pages -}}
  {{/* Les 762 pages photo sont volontairement hors recherche : elles noieraient les
       galeries. On les écarte par leur section plutôt que via excludeFromSearch, que
       le template de sitemap du thème utilise aussi — les y laisser les rendrait
       non indexables, ce qui est précisément l'inverse du but. */}}
  {{- if and (not .Params.excludeFromSearch) (ne .Section "photo") -}}
    {{- $section := .Site.GetPage "section" .Section -}}
    {{- $item := (dict
      "title" (.Title | emojify | safeJS)
      "section" ($section.Title | emojify | safeJS)
      "summary" (.Summary | plainify | htmlUnescape | safeJS)
      "content" (.Plain | safeJS)
      "permalink" .RelPermalink
      "externalUrl" .Params.externalUrl
      "type" .Type
      "tags" (.Params.tags | default slice)
      "color" (.Params.dominant_color | default "")
    ) -}}
    {{- if .Date -}}
      {{- $item = merge $item (dict "date" (.Date | time.Format (.Site.Language.Params.dateFormat | default ":date_long"))) -}}
    {{- end -}}
    {{- $index = $index | append $item -}}
  {{- end -}}
{{- end -}}
{{- $index | jsonify -}}
